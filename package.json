{
  "name": "gymflow-erp",
  "version": "1.0.0",
  "private": true,
  "description": "GymFlow ERP - Commercial Multi-Tenant Gym Management SaaS Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@gymflow/web",
    "dev:api": "npm run dev --workspace=@gymflow/api",
    "build:web": "npm run build --workspace=@gymflow/web",
    "build:api": "npm run build --workspace=@gymflow/api",
    "build": "npm run build --workspaces --if-present",
    "lint:web": "npm run lint --workspace=@gymflow/web",
    "lint:api": "npm run lint --workspace=@gymflow/api",
    "lint": "npm run lint --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:api": "jest tests/api"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
